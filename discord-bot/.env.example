# Copie ce fichier en ".env" puis remplis les valeurs.
# Ne partage JAMAIS ton token et ne commit jamais le fichier .env.

# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur Discord (clic droit sur le serveur > Copier l'identifiant du serveur)
GUILD_ID=

# Pseudo de la créatrice : utilisé pour son rôle et le nom des rôles/catégories
PSEUDO=littledesire

# Nom à donner au serveur (laisser vide pour ne pas renommer)
SERVER_NAME=littledesire

# IDs des personnes à qui donner les rôles automatiquement (séparés par des virgules)
# Le propriétaire du serveur reçoit toujours le rôle Fondateur.
FONDATEUR_IDS=
CREATRICE_IDS=
MANAGER_IDS=

# Lancer la configuration du serveur automatiquement au démarrage (true/false)
AUTO_SETUP=true
