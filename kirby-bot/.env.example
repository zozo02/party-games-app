# Copie ce fichier en ".env" puis remplis les valeurs.
# Ne partage JAMAIS ton token et ne commit jamais le fichier .env.
# IMPORTANT : ce bot doit avoir SON PROPRE token (une nouvelle application
# dans le Developer Portal), pas celui du bot littledesire.

# Token du bot (Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID du serveur Discord (clic droit sur le serveur > Copier l'identifiant du serveur)
GUILD_ID=

# Nom de la créatrice et du serveur (affichés dans le panneau des tickets, etc.)
PSEUDO=Kirby
SERVER_NAME=Kirby World

# Rôles qui voient tous les tickets et peuvent les prendre en charge / renommer.
# IDs séparés par des virgules (clic droit sur un rôle > Copier l'identifiant du rôle).
# Ex : Fondateur, Kirby, Manager
STAFF_ROLE_IDS=

# Rôle(s) donné(s) quand quelqu'un clique sur "J'accepte le règlement".
# S'il y en a plusieurs, mets-les sur la MÊME ligne, séparés par une virgule :
#   MEMBER_ROLE_IDS=111111111111111111,222222222222222222
# Laisse vide pour utiliser le rôle qui s'appelle "Membre".
MEMBER_ROLE_IDS=

# Rôles Homme / Femme du choix du genre (optionnel).
# Laisse vide : le bot cherche un rôle qui s'appelle "Homme" / "Femme", et les crée s'ils n'existent pas.
HOMME_ROLE_ID=
FEMME_ROLE_ID=

# Catégories où s'ouvrent les tickets (optionnel).
# Laisse vide : /installer tickets crée les 3 catégories (visibles seulement par le staff).
CATEGORIE_PRESTATION_ID=
CATEGORIE_QUESTION_ID=
CATEGORIE_REPORT_ID=

# Images du panneau des tickets (optionnel). Tu peux aussi mettre tes images
# dans le dossier assets/ : voir assets/LISEZ-MOI.txt
TICKET_MINIATURE_URL=
TICKET_IMAGE_URL=
